# Hostinger Business single-app staging template.
# Put real secrets in Hostinger Environment Variables, never in Git.

NODE_ENV=production
DEPLOY_ENVIRONMENT=staging

# Replace with the temporary *.hostingersite.com origin first.
PUBLIC_APP_URL=https://your-hostinger-test-domain.hostingersite.com
FRONTEND_URL=https://your-hostinger-test-domain.hostingersite.com
CORS_ORIGIN=https://your-hostinger-test-domain.hostingersite.com
TRUST_PROXY=1
# Hostinger root wrapper serves the built frontend and proxies backend routes.

# Frontend build-time settings.
VITE_API_URL=/api
VITE_PUBLIC_SITE_URL=https://your-hostinger-test-domain.hostingersite.com
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# External PostgreSQL is required on Hostinger Business Web Hosting.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Authentication.
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Optional until email/password-reset testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Single-process Hostinger staging mode.
RUN_MIGRATIONS_ON_STARTUP=true
RUN_BACKGROUND_JOBS_IN_WEB=true
REQUIRE_BACKGROUND_WORKER=false

# Keep local only for short-lived testing. Configure R2/S3 before relying on uploads.
PRIVATE_OBJECT_STORAGE_DRIVER=local
