PORT=5000
# Preferred on managed hosting: paste the full PostgreSQL Session Pooler URL here.
# When DATABASE_URL is set, DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are optional.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propulse
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000
DB_APPLICATION_NAME=propulse-backend
# Keep readiness probes responsive even when PostgreSQL is unavailable.
HEALTH_CHECK_TIMEOUT_MS=2500
# Managed-hosting degraded startup retry interval.
STARTUP_RETRY_MS=30000
# HTTP server resilience defaults; tune only with proxy/load-balancer timeouts in mind.
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
# Log only production requests slower than this threshold (5xx are always logged).
SLOW_REQUEST_MS=2000
# Persist deduplicated 5xx, slow-request, browser-crash and fatal worker/server fingerprints for Admin Error Monitor.
OPERATIONAL_MONITORING_ENABLED=true
# Resolved fingerprints older than this are pruned when the web process starts.
OPERATIONAL_EVENT_RETENTION_DAYS=90
DB_SSL=false
# Supabase Session Pooler on managed hosting uses encrypted TLS. Without the
# project CA, the app falls back to PostgreSQL sslmode=require semantics for
# *.pooler.supabase.com so SELF_SIGNED_CERT_IN_CHAIN does not block startup.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: base64-encoded Supabase prod CA PEM. When set, strict CA
# verification is enabled automatically for the pooler connection.
DB_SSL_CA_BASE64=
NODE_ENV=development
# In production, use the exact HTTPS frontend origin. Keep the browser and API
# same-origin via /api unless the cookie/CSRF model is intentionally redesigned.
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TRUST_PROXY=false
# When deployed behind exactly one trusted reverse proxy, use TRUST_PROXY=1.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Required for password-reset email delivery.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ProPulse Business <onboarding@resend.dev>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Propulse Admin

# Deployment process controls. Local/single-process defaults are shown below.
# For multi-instance production, prefer the explicit false values documented here.
# In multi-instance production, run "npm run db:migrate" once during release,
# then set RUN_MIGRATIONS_ON_STARTUP=false on every long-running process.
RUN_MIGRATIONS_ON_STARTUP=true
# To move scheduled jobs out of the web service, set this false on web instances
# and run one or more supervised "npm run worker" processes instead.
RUN_BACKGROUND_JOBS_IN_WEB=true
# Normally migrations belong to the release step, not the worker.
RUN_MIGRATIONS_ON_WORKER_STARTUP=false
# Dedicated-worker monitoring. Enable REQUIRE_BACKGROUND_WORKER on web instances only
# when RUN_BACKGROUND_JOBS_IN_WEB=false and a supervised npm run worker service exists.
REQUIRE_BACKGROUND_WORKER=false
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
# System Health keeps isolated/temporary Google Sheet failures at attention and
# degrades only after this many consecutive connection failures.
SYSTEM_HEALTH_SHEET_FAILURE_THRESHOLD=3
# Daily financial reconciliation. The scheduler also runs once on process startup when due.
FINANCIAL_RECONCILIATION_INTERVAL_MS=86400000
# System Health marks automated reconciliation stale after this many hours.
FINANCIAL_RECONCILIATION_MAX_AGE_HOURS=30

# Backup / restore verification. Keep production backup artifacts on durable,
# access-controlled storage outside the Git checkout.
BACKUP_DIRECTORY=
PRIVATE_STORAGE_BACKUP_DIRECTORY=
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Prefer an isolated PostgreSQL verification host/user with CREATEDB permission.
# When unset, host/port/user/password/SSL fall back to DB_* for local/CI use.
RESTORE_VERIFY_DB_HOST=
RESTORE_VERIFY_DB_PORT=
RESTORE_VERIFY_DB_USER=
RESTORE_VERIFY_DB_PASSWORD=
RESTORE_VERIFY_DB_SSL=
RESTORE_VERIFY_DB_SSL_REJECT_UNAUTHORIZED=
RESTORE_VERIFY_MAINTENANCE_DB=postgres
# Enable this on production web instances after a scheduled backup:all job exists.
REQUIRE_BACKUP_VERIFICATION=false
BACKUP_VERIFICATION_MAX_AGE_HOURS=30

# Persistent/shared upload volume. In production, point this to durable storage
# mounted at the same path on every web/worker replica. Leave blank locally to
# keep using backend/uploads.
UPLOAD_STORAGE_ROOT=

# Sensitive/private upload backend. "local" keeps proofs under UPLOAD_STORAGE_ROOT.
# "s3" stores new payment, payout and company-verification proofs in a private
# S3-compatible bucket and serves them with short-lived signed URLs.
PRIVATE_OBJECT_STORAGE_DRIVER=local
PRIVATE_OBJECT_STORAGE_ENDPOINT=
PRIVATE_OBJECT_STORAGE_REGION=us-east-1
PRIVATE_OBJECT_STORAGE_BUCKET=
PRIVATE_OBJECT_STORAGE_ACCESS_KEY_ID=
PRIVATE_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional for temporary STS-style credentials.
PRIVATE_OBJECT_STORAGE_SESSION_TOKEN=
# true works with MinIO/R2/custom S3 endpoints and explicit bucket paths.
PRIVATE_OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Private proof URLs are capped at 5 minutes. Default 60 seconds.
PRIVATE_OBJECT_STORAGE_SIGNED_URL_SECONDS=60
# Required in production when S3 is enabled. Configure the corresponding bucket-side protection.
# Allowed: bucket_versioning | replication | external_backup
PRIVATE_OBJECT_STORAGE_BACKUP_STRATEGY=

# Optional separate HMAC secret for Risk Center fingerprints. Falls back to JWT_SECRET.
RISK_EVENT_HASH_SECRET=

# Central notifications
# Email outbox polling interval (default 60000 = 1 minute).
NOTIFICATION_DELIVERY_INTERVAL_MS=60000
# Membership-expiry reminder scan interval (default 21600000 = 6 hours).
NOTIFICATION_REMINDER_INTERVAL_MS=21600000
# Used to build links in notification emails, e.g. https://app.example.com
FRONTEND_URL=

# Online payment gateway (Razorpay)
# Keep KEY_SECRET and WEBHOOK_SECRET server-side only. KEY_ID is safe to expose to Razorpay Checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure Razorpay Dashboard webhook URL as:
#   https://YOUR_API_DOMAIN/api/payment-webhooks/razorpay
# Subscribe at minimum to payment.captured and payment.failed.

# Admin Database & API Performance Center thresholds.
PERFORMANCE_LONG_QUERY_SECONDS=5
PERFORMANCE_IDLE_TX_SECONDS=60
PERFORMANCE_DEAD_TUPLE_WARN_PERCENT=20
PERFORMANCE_DEAD_TUPLE_MIN_ROWS=1000
PERFORMANCE_API_WINDOW_DAYS=7

# Release identity. Deployed staging and production both use NODE_ENV=production.
# Set DEPLOY_ENVIRONMENT=staging on staging and =production on production.
DEPLOY_ENVIRONMENT=
# Map this to the exact deployed Git SHA if the hosting provider does not expose a recognized commit variable.
GIT_COMMIT_SHA=
# Optional opaque release/deployment identifier shown in Admin System Health and /health/version.
RELEASE_ID=

# Telegram support chat
# Create a Telegram bot with @BotFather and add it to the support group/supergroup.
# Keep BOT_TOKEN and WEBHOOK_SECRET server-side only.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
# 16-256 chars; letters, numbers, underscore and hyphen only.
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
# Optional. Defaults to PUBLIC_APP_URL + /api/support-chat/telegram/webhook.
TELEGRAM_SUPPORT_WEBHOOK_URL=
# Optional when routing support into a Telegram forum topic.
TELEGRAM_SUPPORT_MESSAGE_THREAD_ID=

# Global API request protection.
# Production defaults to 600 requests per 15 minutes per identity.
# Development defaults to 10000 so Vite/HMR and local testing do not exhaust one localhost bucket.
# Route-specific limits (login, recovery, uploads, support writes, etc.) remain separate.
API_GLOBAL_RATE_LIMIT_MAX=
API_GLOBAL_RATE_LIMIT_WINDOW_MS=
