PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propulse
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000
DB_APPLICATION_NAME=propulse-backend
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
NODE_ENV=development
# In production, use the exact HTTPS frontend origin. Keep the browser and API
# same-origin via /api unless the cookie/CSRF model is intentionally redesigned.
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TRUST_PROXY=false
# When deployed behind exactly one trusted reverse proxy, use TRUST_PROXY=1.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Required for password-reset email delivery.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ProPulse Business <onboarding@resend.dev>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Propulse Admin
