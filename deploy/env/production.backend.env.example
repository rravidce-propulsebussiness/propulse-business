# Copy to a secret file outside Git and replace every placeholder.
# Compose/release controls. Keep the app container bound to loopback behind your TLS reverse proxy/load balancer.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080

# Public application identity
PUBLIC_APP_URL=https://your-real-production-domain.com
FRONTEND_URL=https://your-real-production-domain.com
CORS_ORIGIN=https://your-real-production-domain.com
# Optional; used by docker compose when building the frontend for Search Console verification.
GOOGLE_SITE_VERIFICATION=

# PostgreSQL: production-only managed database/account.
DB_HOST=production-db-host
DB_PORT=5432
DB_NAME=propulse_production
DB_USER=propulse_production
DB_PASSWORD=replace-with-production-db-password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# Auth / external services
JWT_SECRET=replace-with-a-random-production-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-production-google-web-client-id.apps.googleusercontent.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Runtime monitoring
OPERATIONAL_MONITORING_ENABLED=true
OPERATIONAL_EVENT_RETENTION_DAYS=90
SLOW_REQUEST_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
SYSTEM_HEALTH_SHEET_FAILURE_THRESHOLD=3
FINANCIAL_RECONCILIATION_INTERVAL_MS=86400000
FINANCIAL_RECONCILIATION_MAX_AGE_HOURS=30

# Single-host deployment can start with the shared durable Docker volume.
# Before multiple web hosts/replicas, use a private S3-compatible bucket for sensitive proofs.
PRIVATE_OBJECT_STORAGE_DRIVER=local
PRIVATE_OBJECT_STORAGE_ENDPOINT=
PRIVATE_OBJECT_STORAGE_REGION=us-east-1
PRIVATE_OBJECT_STORAGE_BUCKET=
PRIVATE_OBJECT_STORAGE_ACCESS_KEY_ID=
PRIVATE_OBJECT_STORAGE_SECRET_ACCESS_KEY=
PRIVATE_OBJECT_STORAGE_SESSION_TOKEN=
PRIVATE_OBJECT_STORAGE_FORCE_PATH_STYLE=true
PRIVATE_OBJECT_STORAGE_SIGNED_URL_SECONDS=60
PRIVATE_OBJECT_STORAGE_BACKUP_STRATEGY=

# Configure live Razorpay values only after webhook/domain verification. Admin can still disable the gateway operationally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Turn this on after backup:all is actually scheduled and its artifacts are stored off-host.
REQUIRE_BACKUP_VERIFICATION=false
BACKUP_VERIFICATION_MAX_AGE_HOURS=30

HEALTH_CHECK_TIMEOUT_MS=2500
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# Telegram support chat
# Create a Telegram bot with @BotFather and add it to the support group/supergroup.
# Keep BOT_TOKEN and WEBHOOK_SECRET server-side only.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
# 16-256 chars; letters, numbers, underscore and hyphen only.
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
# Optional. Defaults to PUBLIC_APP_URL + /api/support-chat/telegram/webhook.
TELEGRAM_SUPPORT_WEBHOOK_URL=
# Optional when routing support into a Telegram forum topic.
TELEGRAM_SUPPORT_MESSAGE_THREAD_ID=

# Global API request protection.
# Production defaults to 600 requests per 15 minutes per identity.
# Development defaults to 10000 so Vite/HMR and local testing do not exhaust one localhost bucket.
# Route-specific limits (login, recovery, uploads, support writes, etc.) remain separate.
API_GLOBAL_RATE_LIMIT_MAX=
API_GLOBAL_RATE_LIMIT_WINDOW_MS=
