VITE_API_URL=/api
# Optional legacy build-time value; Google login now loads the public client ID from /api/auth/google/config.
# The backend GOOGLE_CLIENT_ID is required for Google sign-in.
VITE_GOOGLE_CLIENT_ID=
# Canonical public origin used for production SEO metadata, e.g. https://example.com
VITE_PUBLIC_SITE_URL=

# Optional Google Search Console HTML-tag verification token (content value only)
VITE_GOOGLE_SITE_VERIFICATION=
